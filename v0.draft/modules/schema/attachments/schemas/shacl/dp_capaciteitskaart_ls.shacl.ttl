cim:NameType a sh:NodeShape ;
    sh:closed false ;
    sh:description """Type of name. Possible values for attribute 'name' are implementation dependent but standard profiles may specify types. An enterprise may have multiple IT systems each having its own local name for the same object, e.g. a planning system may have different names from an EMS. An object may also have different names within the same IT system, e.g. localName as defined in CIM version 14. The definition from CIM14 is:\r
The localName is a human readable name of the object. It is a free text name local to a node in a naming hierarchy similar to a file directory structure. A power system related naming hierarchy may be: Substation, VoltageLevel, Equipment etc. Children of the same parent in such a hierarchy have names that typically are unique among them.\r
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Description of the name type.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path cim:NameType.description ],
        [ sh:class cim:NameTypeAuthority ;
            sh:description "Authority responsible for managing names of this type." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path cim:NameType.NameTypeAuthority ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the name type.\r
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path cim:NameType.name ] ;
    sh:targetClass cim:NameType .

cim:NameTypeAuthority a sh:NodeShape ;
    sh:closed false ;
    sh:description """Authority responsible for creation and management of names of a given type; typically an organization or an enterprise system.\r
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Name of the name type authority.\r
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path cim:NameTypeAuthority.name ],
        [ sh:datatype xsd:string ;
            sh:description """Description of the name type authority.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path cim:NameTypeAuthority.description ] ;
    sh:targetClass cim:NameTypeAuthority .

cim:OperatingParticipant a sh:NodeShape ;
    sh:closed false ;
    sh:description """An operator of multiple power system resource objects. Note multple operating participants may operate the same power system resource object. This can be used for modeling jointly owned units where each owner operates as a contractual share.\r
""" ;
