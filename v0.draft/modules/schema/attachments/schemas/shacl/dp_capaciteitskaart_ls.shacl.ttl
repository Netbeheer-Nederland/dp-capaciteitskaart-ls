            sh:order 1 ;
            sh:path cim:NameTypeAuthority.name ],
        [ sh:datatype xsd:string ;
            sh:description """Description of the name type authority.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path cim:NameTypeAuthority.description ] ;
    sh:targetClass cim:NameTypeAuthority .

cim:OperatingParticipant a sh:NodeShape ;
    sh:closed false ;
    sh:description """An operator of multiple power system resource objects. Note multple operating participants may operate the same power system resource object. This can be used for modeling jointly owned units where each owner operates as a contractual share.\r
""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
