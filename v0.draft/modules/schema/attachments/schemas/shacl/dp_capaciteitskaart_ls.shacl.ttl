cim:WorkTask a sh:NodeShape ;
    sh:closed false ;
    sh:description "A task within a set of work." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class cim:Asset ;
            sh:description "All assets on which this non-replacement work task is performed." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path cim:WorkTask.Assets ],
        [ sh:description "Kind of work." ;
            sh:in ( cim:WorkTaskKind.exchange cim:WorkTaskKind.install cim:WorkTaskKind.investigate cim:WorkTaskKind.remove ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path cim:WorkTask.taskKind ],
        [ sh:description "Kind of work status." ;
            sh:in ( cim:WorkStatusKind.approved cim:WorkStatusKind.cancelled cim:WorkStatusKind.closed cim:WorkStatusKind.completed cim:WorkStatusKind.dispatched cim:WorkStatusKind.enroute cim:WorkStatusKind.inProgress cim:WorkStatusKind.onSite cim:WorkStatusKind.scheduled cim:WorkStatusKind.waitingOnApproval cim:WorkStatusKind.waitingOnMaterial cim:WorkStatusKind.waitingToBeScheduled ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path cim:BaseWork.statusKind ],
        [ sh:class cim:WorkLocation ;
            sh:description "Location for this work/task." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path cim:BaseWork.WorkLocation ],
        [ sh:class cim:Name ;
            sh:description "All names of this identified object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path cim:IdentifiedObject.Names ],
        [ sh:datatype xsd:string ;
            sh:description "The description is a free human readable text describing or naming the object. It may be non unique and may not correlate to a naming hierarchy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path cim:IdentifiedObject.description ],
        [ sh:datatype xsd:string ;
            sh:description """Master resource identifier issued by a model authority. The mRID is unique within an exchange context. Global uniqueness is easily achieved by using a UUID, as specified in RFC 4122, for the mRID. The use of UUID is strongly recommended.\r
For CIMXML data files in RDF syntax conforming to IEC 61970-552, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path cim:IdentifiedObject.mRID ],
        [ sh:class cim:WorkTimeSchedule ;
            sh:description "All time schedules for this work or work task." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path cim:BaseWork.TimeSchedules ],
        [ sh:class cim:Work ;
            sh:description "Work this task belongs to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path cim:WorkTask.Work ],
        [ sh:description "Kind of work." ;
            sh:in ( cim:ServiceRequestKind.connect cim:ServiceRequestKind.construction cim:ServiceRequestKind.disconnect cim:ServiceRequestKind.inspection cim:ServiceRequestKind.newservice cim:ServiceRequestKind.other cim:ServiceRequestKind.reconnect cim:ServiceRequestKind.repair cim:ServiceRequestKind.replace cim:ServiceRequestKind.test cim:ServiceRequestKind.turn-off cim:ServiceRequestKind.turn-on ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path cim:BaseWork.kind ],
        [ sh:datatype xsd:string ;
            sh:description """The name is any free human readable and possibly non unique text naming the object.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path cim:IdentifiedObject.name ] ;
    sh:targetClass cim:WorkTask .

cim:Zone a sh:NodeShape ;
    sh:closed false ;
    sh:description "Area divided off from other areas. It may be part of the electrical network, a land area where special restrictions apply, weather areas, etc. For weather, it is an area where a set of relatively homogenous weather measurements apply." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Kind of this zone." ;
            sh:in ( cim:ZoneKind.electricalNetwork cim:ZoneKind.other cim:ZoneKind.specialRestrictionLand cim:ZoneKind.weatherZone ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path cim:Zone.kind ],
        [ sh:datatype xsd:string ;
            sh:description """Master resource identifier issued by a model authority. The mRID is unique within an exchange context. Global uniqueness is easily achieved by using a UUID, as specified in RFC 4122, for the mRID. The use of UUID is strongly recommended.\r
For CIMXML data files in RDF syntax conforming to IEC 61970-552, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path cim:IdentifiedObject.mRID ],
        [ sh:class cim:Name ;
            sh:description "All names of this identified object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path cim:IdentifiedObject.Names ],
        [ sh:datatype xsd:string ;
            sh:description """The name is any free human readable and possibly non unique text naming the object.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path cim:IdentifiedObject.name ],
        [ sh:datatype xsd:string ;
            sh:description "The description is a free human readable text describing or naming the object. It may be non unique and may not correlate to a naming hierarchy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path cim:IdentifiedObject.description ],
        [ sh:class cim:StreetAddress ;
            sh:description "Main address of the location." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path cim:Location.mainAddress ] ;
    sh:targetClass cim:Zone .

cim:Asset a sh:NodeShape ;
    sh:closed false ;
    sh:description "Tangible resource of the utility, including power system equipment, various end devices, cabinets, buildings, etc. For electrical network equipment, the role of the asset is defined through PowerSystemResource and its subclasses, defined mainly in the Wires model (refer to IEC61970-301 and model package IEC61970::Wires). Asset description places emphasis on the physical characteristics of the equipment fulfilling that role." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Indication of whether asset is currently deployed (in use), ready to be put into use or not available for use." ;
            sh:in ( cim:InUseStateKind.inUse cim:InUseStateKind.notReadyForUse cim:InUseStateKind.readyForUse ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path cim:Asset.inUseState ],
        [ sh:datatype xsd:string ;
            sh:description """Master resource identifier issued by a model authority. The mRID is unique within an exchange context. Global uniqueness is easily achieved by using a UUID, as specified in RFC 4122, for the mRID. The use of UUID is strongly recommended.\r
For CIMXML data files in RDF syntax conforming to IEC 61970-552, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path cim:IdentifiedObject.mRID ],
        [ sh:datatype xsd:string ;
            sh:description """Utility-specific classification of Asset and its subtypes, according to their corporate standards, practices, and existing IT systems (e.g., for management of assets, maintenance, work, outage, customers, etc.).\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path cim:Asset.type ],
        [ sh:datatype xsd:string ;
            sh:description """The name is any free human readable and possibly non unique text naming the object.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path cim:IdentifiedObject.name ],
        [ sh:class cim:Location ;
            sh:description "Location of this asset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path cim:Asset.Location ],
        [ sh:class cim:PowerSystemResource ;
            sh:description "All power system resources used to electrically model this asset. For example, transformer asset is electrically modelled with a transformer and its windings and tap changer." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path cim:Asset.PowerSystemResources ],
        [ sh:datatype xsd:string ;
            sh:description "The description is a free human readable text describing or naming the object. It may be non unique and may not correlate to a naming hierarchy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path cim:IdentifiedObject.description ],
        [ sh:class cim:Name ;
            sh:description "All names of this identified object." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path cim:IdentifiedObject.Names ] ;
    sh:targetClass cim:Asset .

