            sh:path cim:Name.NameType ],
        [ sh:datatype xsd:string ;
            sh:description """Any free text that name the object.\r
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path cim:Name.name ] ;
    sh:targetClass cim:Name .


